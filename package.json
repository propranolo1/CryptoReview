{
  "name": "cryptoreview-desktop",
  "productName": "CryptoReview",
  "version": "0.2.7",
  "description": "Binance 与 OKX U 本位合约本地交易复盘桌面应用",
  "author": "xin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/propranolo1/CryptoReview.git"
  },
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "predev": "npm run prepare:ocr",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run prepare:ocr",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:run": "npm run build && electron .",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make:win": "npm run build && electron-forge make --platform win32 --arch x64",
    "desktop:make:mac:arm64": "npm run build && node scripts/make-macos.mjs arm64",
    "desktop:make:mac:x64": "npm run build && node scripts/make-macos.mjs x64",
    "desktop:make:mac": "npm run build && node scripts/make-macos.mjs arm64 x64",
    "test": "npm run build && node --test tests/*.test.mjs",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "electron": "43.1.1",
    "encoding": "0.1.13",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "iconv-lite": "0.6.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
